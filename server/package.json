{
  "name": "@simpas/id-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "keys:rotate": "tsx src/lib/keys.ts rotate",
    "api:lint": "spectral lint openapi/simpasid.v1.yaml --ruleset openapi/.spectral.yaml",
    "api:diff": "oasdiff breaking"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "oidc-provider": "^8.8.1",
    "pg": "^8.13.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@fastify/middie": "^9.3.4",
    "@stoplight/spectral-cli": "^6.14.2",
    "@types/node": "^22.10.5",
    "@types/oidc-provider": "^9.12.0",
    "@types/pg": "^8.11.10",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
