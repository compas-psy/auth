# Ни одного секрета: единственный критичный секрет — ключи подписи —
# сервис заводит себе сам при первом запуске (Задача 16, шаг 4).
DATABASE_URL=postgres://simpasid:CHANGE_ME@postgres:5432/simpasid
ISSUER=https://auth.cmpas.ru
PORT=3000
HOST=0.0.0.0
KEYS_DIR=/var/lib/simpasid/keys

# Ключи внешних способов входа. Пока их нет — провайдер не появляется
# ни на экране входа, ни на маршруте возврата, и это не ошибка.
# Redirect URI, зарегистрированный у провайдера, обязан совпадать точно:
#   https://auth.cmpas.ru/callback/yandex
# Половины пары недостаточно: сервис не подключит провайдера, чтобы не
# показывать кнопку, ведущую в ошибку.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
